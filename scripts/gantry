#!/usr/bin/env bash
set -euo pipefail

url=${GANTRY_URL:-http://127.0.0.1:4737}
url=${url%/}
timeout=${GANTRY_WATCH_SECONDS:-1800}
cli_dir=$(dirname -- "$0")
http_status=
retry_after=
schema=$cli_dir/gantry-schema.json
[[ -r $schema ]] || schema=$cli_dir/../share/gantry/cli-schema.json

error() {
  local status=$1 code=$2 message=$3 field=${4:-}
  jq -nc --arg code "$code" --arg message "$message" --arg field "$field" \
    --arg http_status "${http_status:-}" --arg retry_after "${retry_after:-}" '
    {error: ({code: $code, message: $message}
      + (if $field == "" then {} else {field: $field} end)
      + (if $http_status == "" then {} else {http_status: ($http_status | tonumber)} end)
      + (if $retry_after == "" then {} else {retry_after: $retry_after} end))}
  ' >&2
  exit "$status"
}

invalid() {
  error 2 invalid_input "$1" "${2:-}"
}

# This validator implements the JSON Schema keywords used by the CLI schema.
validate() {
  jq -rcs --slurpfile doc "$schema" --arg definition "$1" '
    def valid($schema):
      . as $value |
      if $schema["$ref"] then
        valid($doc[0]["$defs"][$schema["$ref"] | split("/") | last])
      elif $schema.oneOf then
        [$schema.oneOf[] | select(. as $branch | $value | valid($branch))] | length == 1
      elif $schema | has("const") then
        $value == $schema.const
      elif $schema.type == "integer" then
        type == "number" and (tostring | test("^[0-9]+$")) and
        . >= ($schema.minimum // .) and
        . <= ($schema.maximum // .)
      elif type != $schema.type then
        false
      elif type == "string" then
        length <= ($schema.maxLength // length) and
        (if $schema.pattern then any(match($schema.pattern; "s"); .string == $value) else true end)
      elif type == "array" then
        length >= ($schema.minItems // length) and
        length <= ($schema.maxItems // length) and
        ($schema.uniqueItems != true or length == (unique | length)) and
        all(.[]; valid($schema.items))
      elif type == "object" then
        all($schema.required[]; . as $key | $value | has($key)) and
        all(to_entries[]; $schema.properties[.key] as $property |
          if $property then .value | valid($property) else $schema.additionalProperties end)
      else
        true
      end;

    if length == 1 and (.[0] | valid($doc[0]["$defs"][$definition])) then
      .[0] | tojson
    else
      error("invalid payload")
    end
  ' 2>/dev/null
}

version() {
  local version_file="$cli_dir/../releases/gantry-version" label
  label='Gantry source CLI'
  if [[ -r $version_file ]]; then label=$(cat -- "$version_file"); fi
  if [[ $output == json ]]; then
    jq -nc --arg version "$label" '{version:$version}'
  else
    printf '%s\n' "$label"
  fi
}

describe() {
  local name=${1:-}
  if [[ -z $name ]]; then
    jq -c . "$schema"
  elif ! jq -ce --arg name "$name" '
    .commands[$name] as $command |
    select($command != null) |
    {schema_version, positional_separator, command: $name, exit_codes, "$defs": .["$defs"]} +
    ($command + {options: ( .options | with_entries(select(.key as $key | $command.options | index($key))))})
  ' "$schema"; then
    invalid "Unknown command. Run gantry describe to see available commands." command
  fi
}

help_text() {
  jq -r --arg name "${1:-}" '
    if $name == "" then
      .commands[].usage, "gantry --help --json", "gantry --version"
    else
      .commands[$name] | .usage, .description
    end,
    "Use -- before positional arguments that begin with a dash.",
    "Run gantry describe [COMMAND] for options, schemas and exit codes."
  ' "$schema"
}

emit() {
  if [[ -z $fields ]]; then
    printf '%s\n' "$1"
    return
  fi
  jq -c --arg fields "$fields" '
    def present($path):
      if $path == [] then true
      elif type != "object" or (has($path[0]) | not) then false
      else .[$path[0]] | present($path[1:])
      end;

    . as $result |
    reduce ($fields | split(",") | map(split(".")) | sort_by(length)[]) as $path
      ({}; if $result | present($path) then setpath($path; $result | getpath($path)) else . end)
  ' <<<"$1"
}

# Parse options in any position. A literal -- ends option processing.
command=
output=
fields=
payload=
payload_set=false
dry_run=false
help=false
json_help=false
version_requested=false
init_local=false
token_stdin=false
args=()
while (( $# )); do
  case $1 in
    --output|--fields|--json)
      option=$1
      if [[ $option == --json && $# == 1 && $help == true ]]; then
        json_help=true
        shift
        continue
      fi
      (( $# >= 2 )) || invalid "Missing value for $option." "$option"
      value=$2
      [[ -n $value && $value != --* ]] || invalid "Missing value for $option." "$option"
      case $option in
        --output) [[ -z $output ]] || invalid "Duplicate option." "$option"; output=$value ;;
        --fields) [[ -z $fields ]] || invalid "Duplicate option." "$option"; fields=$value ;;
        --json) [[ $payload_set == false ]] || invalid "Duplicate option." "$option"; payload=$value; payload_set=true ;;
      esac
      shift 2
      ;;
    --dry-run) dry_run=true; shift ;;
    --local) [[ $init_local == false ]] || invalid "Duplicate option." --local; init_local=true; shift ;;
    --token-stdin) [[ $token_stdin == false ]] || invalid "Duplicate option." --token-stdin; token_stdin=true; shift ;;
    -h|--help) help=true; shift ;;
    --version) version_requested=true; shift ;;
    --) shift; args+=("$@"); break ;;
    -*) invalid "Unknown option. Run gantry --help for usage." option ;;
    *)
      if [[ -z $command ]]; then command=$1; else args+=("$1"); fi
      shift
      ;;
  esac
done

if [[ $version_requested == true ]]; then
  [[ -z $command && ${#args[@]} == 0 && $help == false && $payload_set == false &&
    $dry_run == false && $init_local == false && $token_stdin == false &&
    -z $fields && ( -z $output || $output == json ) ]] ||
    invalid "Use gantry --version [--output json]."
  version
  exit 0
fi

[[ -r $schema ]] || error 1 missing_schema "Could not read the Gantry CLI schema."
case $command in
  plan|run|submit|status|watch|blob|skill|describe|init|local|worker|'') ;;
  *) invalid "Unknown command. Run gantry describe to see available commands." command ;;
esac

if [[ $help == true ]]; then
  [[ ${#args[@]} == 0 && $payload_set == false && $dry_run == false && -z $fields &&
    $init_local == false && $token_stdin == false &&
    ( -z $output || $output == json ) ]] || invalid "Use --help or --help --json."
  if [[ $json_help == true || $output == json ]]; then describe "$command"; else help_text "$command"; fi
  exit 0
fi

case $command in
  '') invalid "A command is required. Run gantry --help." command ;;
  blob) [[ -z $output || $output == raw ]] || invalid "Blob emits bytes. Use --output raw." --output ;;
  skill) [[ -z $output || $output == raw ]] || invalid "Skill emits Markdown. Use --output raw." --output ;;
  *) [[ -z $output || $output == json ]] || invalid "Use --output json." --output ;;
esac

[[ $init_local == false || $command == init ]] || invalid "Use --local with init." --local
[[ $token_stdin == false || $command == worker ]] ||
  invalid "Use --token-stdin with worker setup." --token-stdin
if [[ $command == describe ]]; then
  [[ ${#args[@]} -le 1 && $payload_set == false && $dry_run == false && -z $fields ]] ||
    invalid "Use gantry describe [COMMAND]."
  describe "${args[0]:-}"
  exit 0
fi

if [[ $command == skill ]]; then
  [[ ${#args[@]} == 0 && $payload_set == false && $dry_run == false && -z $fields ]] ||
    invalid "Use gantry skill [--output raw]."
  skill_file=$cli_dir/../skills/gantry/SKILL.md
  [[ -r $skill_file ]] || skill_file=$cli_dir/../share/gantry/skill/SKILL.md
  [[ -r $skill_file ]] || error 1 missing_skill "Could not read the Gantry agent skill."
  cat -- "$skill_file"
  exit 0
fi

# Validate projection paths for both local and HTTP JSON commands.
if [[ -n $fields ]]; then
  path_pattern='[A-Za-z_][A-Za-z0-9_-]*(\.[A-Za-z_][A-Za-z0-9_-]*)*'
  [[ $command != blob && $dry_run == false && $fields =~ ^$path_pattern(,$path_pattern)*$ ]] ||
    invalid "Use comma-separated object paths on live JSON results." --fields
fi

if [[ $command == init || $command == local || $command == worker ]]; then
  [[ $payload_set == false && $dry_run == false ]] ||
    invalid "Run gantry describe $command for usage."
  helper=$cli_dir/gantry-onboarding
  [[ -r $helper ]] || helper=$cli_dir/../share/gantry/gantry-onboarding
  [[ -r $helper ]] || error 1 missing_helper "Could not find the Gantry onboarding helper."
  case "$command:${args[0]:-}" in
    init:)
      [[ $init_local == true && ${#args[@]} == 0 ]] || invalid "Use gantry init --local."
      ;;
    local:start|worker:start)
      [[ ${#args[@]} == 1 && -z $fields && -z $output && $token_stdin == false ]] ||
        invalid "Use gantry $command start."
      ;;
    worker:setup)
      [[ ${#args[@]} == 3 ]] || invalid "Use gantry worker setup HTTPS_URL POOL [--token-stdin]."
      ;;
    *) invalid "Run gantry describe $command for usage." ;;
  esac
  source "$helper"
  onboard "${args[@]:1}"
  exit 0
fi

# Keep the URL on HTTP(S), with no embedded user info, query, or fragment.
url_pattern='^https?://([A-Za-z0-9._-]+|\[[0-9A-Fa-f:.]+\])(:([0-9]{1,5}))?(/[A-Za-z0-9._~/-]*)?$'
[[ $url =~ $url_pattern ]] || invalid "Expected an HTTP(S) controller base URL." GANTRY_URL
if [[ -n ${BASH_REMATCH[3]} ]] && (( 10#${BASH_REMATCH[3]} > 65535 )); then
  invalid "Controller port must be at most 65535." GANTRY_URL
fi
case $command in
  plan|run|submit)
    route=$(jq -er --arg command "$command" '.commands[$command].route' "$schema")
    definition=build
    if [[ $command == submit ]]; then definition=submit; fi
    if [[ $payload_set == true ]]; then
      (( ${#args[@]} == 0 )) || invalid "Use either --json or positional arguments." --json
      if [[ $payload == - ]]; then
        payload=$(validate "$definition") ||
          invalid "Expected one request object matching gantry describe $command." --json
      else
        payload=$(validate "$definition" <<<"$payload") ||
          invalid "Expected one request object matching gantry describe $command." --json
      fi
    elif [[ $command == submit ]]; then
      (( ${#args[@]} >= 3 )) || invalid "Use gantry submit ID REPO PR [PR ...]."
      for pull in "${args[@]:2}"; do
        [[ $pull =~ ^[0-9]+$ ]] || invalid "Expected decimal PR numbers." pulls
      done
      payload=$(jq -nc --arg id "${args[0]}" --arg repo "${args[1]}" \
        --args '{id:$id, repo:$repo, pulls:($ARGS.positional | map(tonumber))}' -- "${args[@]:2}")
      payload=$(validate submit <<<"$payload") ||
        invalid "Expected a valid ID, repository and one to sixteen distinct positive PR numbers."
    else
      (( ${#args[@]} == 4 || ${#args[@]} == 5 )) ||
        invalid "Use gantry $command ID REPO COMMIT TARGET [AD_HOC_ACTION.json]."
      action=null
      if (( ${#args[@]} == 5 )); then
        action_file=${args[4]}
        [[ -f $action_file && -r $action_file ]] ||
          invalid "Expected a readable ad hoc action file." action
        action=$(validate action < "$action_file") ||
          invalid "Expected one valid ad hoc action object." action
      fi
      payload=$(jq -c --arg id "${args[0]}" --arg repo "${args[1]}" \
        --arg revision "${args[2]}" --arg target "${args[3]}" \
        '{id:$id, repo:$repo, revision:$revision, target:$target, action:.}' <<<"$action")
      payload=$(validate build <<<"$payload") ||
        invalid "Expected a valid ID, repository, full lowercase Git SHA and target."
    fi
    # Count bytes to match the HTTP request body's Content-Length limit.
    if (( $(LC_ALL=C printf '%s' "$payload" | wc -c) > 262144 )); then
      invalid "Request body exceeds 262144 bytes." --json
    fi
    if [[ $dry_run == true ]]; then
      printf '%s' "$payload" | jq -c --arg url "$url$route" \
        '{dry_run:true, method:"POST", url:$url, body:., validation:"passed"}'
      exit 0
    fi
    if [[ $command == submit ]]; then
      token=${GANTRY_SUBMIT_TOKEN:-}
      credential=GANTRY_SUBMIT_TOKEN
    else
      token=${GANTRY_TOKEN:-}
      credential=GANTRY_TOKEN
    fi
    ;;
  status|watch|blob)
    [[ $payload_set == false && $dry_run == false && ${#args[@]} == 1 ]] ||
      invalid "Run gantry describe $command for usage."
    id=${args[0]}
    kind=id
    route=/v1/runs/$id
    credential='GANTRY_TOKEN or GANTRY_SUBMIT_TOKEN'
    token=${GANTRY_TOKEN:-${GANTRY_SUBMIT_TOKEN:-}}
    if [[ $command == blob ]]; then
      kind=sha256
      route=/v1/blobs/$id
      credential='GANTRY_TOKEN or GANTRY_WORKER_TOKEN'
      token=${GANTRY_TOKEN:-${GANTRY_WORKER_TOKEN:-}}
    fi
    jq -nc --arg id "$id" '$id' | validate "$kind" >/dev/null ||
      invalid "Invalid $kind. Run gantry describe $command for its format." "$kind"
    ;;
esac

if [[ $command == watch ]]; then
  [[ $timeout =~ ^[1-9][0-9]{0,8}$ ]] ||
    invalid "Expected a positive watch deadline in seconds." GANTRY_WATCH_SECONDS
fi
[[ -n $token ]] || error 3 missing_credentials "Set $credential for this operation."
[[ ! $token =~ [[:cntrl:]] ]] || error 3 invalid_credentials "Credential contains a control character."

tmp=$(mktemp -d 2>/dev/null) || error 1 local_io "Could not create a temporary directory."
trap 'rm -rf -- "$tmp"' EXIT
request_args=()
if [[ -n $payload ]]; then
  printf '%s' "$payload" > "$tmp/payload" || error 1 local_io "Could not save the request body."
  request_args=(-H 'Content-Type: application/json' --data-binary "@$tmp/payload")
fi

request() {
  local request_timeout=$1 received
  http_status=
  retry_after=
  if ! received=$(printf 'Authorization: Bearer %s\n' "$token" |
      curl --disable --globoff --path-as-is --proto '=http,https' -s --max-time "$request_timeout" \
        -H @- -o "$tmp/response" -D "$tmp/headers" -w '%{http_code}' \
        "${request_args[@]}" -- "$url$route"); then
    return 1
  fi
  case $received in
    2[0-9][0-9]) return 0 ;;
    [1-5][0-9][0-9]) http_status=$received; return 1 ;;
    *) return 1 ;;
  esac
}

request_error() {
  local message
  if [[ -z $http_status ]]; then
    error 1 transport_error "Could not complete the HTTP request."
  fi
  message=$(jq -ers --arg fallback "Controller returned HTTP $http_status." '
    .[-1] | if type == "object" and (.error | type == "string") then .error[:500] else $fallback end
  ' "$tmp/response" 2>/dev/null) || message="Controller returned HTTP $http_status."
  case $http_status in
    400|411|413|422) error 2 invalid_request "$message" ;;
    401|403) error 3 auth_failed "$message" ;;
    404) error 4 not_found "$message" ;;
    409) error 6 conflict "$message" ;;
    429)
      retry_after=$(awk 'tolower($1) == "retry-after:" {
        sub(/^[^:]*:[ \t]*/, ""); sub(/\r$/, ""); print; exit
      }' "$tmp/headers")
      error 5 rate_limited "$message"
      ;;
    *) error 1 http_error "$message" ;;
  esac
}

response_json() {
  jq -cse 'select(length == 1 and (.[0] | type == "object")) | .[0]' \
    "$tmp/response" 2>/dev/null || error 1 invalid_response "Expected a JSON object from the controller."
}

if [[ $command != watch ]]; then
  request 180 || request_error
  if [[ $command == blob ]]; then
    cat -- "$tmp/response" 2>/dev/null || error 1 local_io "Could not write blob bytes."
  else
    current=$(response_json) || exit "$?"
    emit "$current"
  fi
  exit 0
fi

deadline=$((SECONDS + timeout))
previous=
while (( SECONDS < deadline )); do
  remaining=$((deadline - SECONDS))
  if (( remaining > 180 )); then remaining=180; fi
  if request "$remaining"; then
    current=$(response_json) || exit "$?"
    if [[ $current != "$previous" ]]; then emit "$current"; fi
    previous=$current
    state=$(jq -r '.phase' <<<"$current")
    case $state in
      landed) exit 0 ;;
      failed|blocked) error 1 "run_$state" "Run $id finished with phase $state." ;;
      passed) if jq -e '.submission.kind == "build"' <<<"$current" >/dev/null; then exit 0; fi ;;
    esac
  elif [[ -n $http_status && $http_status != 5?? ]]; then
    request_error
  fi
  sleep 1
done
error 1 watch_timeout "Timed out watching $id."
