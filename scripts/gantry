#!/usr/bin/env bash
# Run the Gleam CLI from a source checkout. A release installs bin/gantry.
set -euo pipefail
server=$(CDPATH= cd -- "$(dirname -- "$0")/../packages/server" && pwd -P)
(cd -- "$server" && gleam build --no-print-progress) >&2
exec erl -pa "$server"/build/dev/erlang/*/ebin -noshell \
  -eval "'gantry@@main':run('gantry@cli')" -extra "$@"
